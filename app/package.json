{
  "name": "measurements",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "test:compile": "tsc --outDir .test-build --rootDir . --strict --module commonjs --target ES2022 --esModuleInterop --skipLibCheck src/*.ts test/*.ts",
    "test": "npm run test:compile && firebase emulators:exec --only firestore --project demo-shadow \"node --test .test-build/test/*.js\""
  },
  "dependencies": {
    "@google-cloud/firestore": "^7.10.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "firebase-admin": "^13.4.0",
    "helmet": "^8.1.0"
  },
  "overrides": {
    "@opentelemetry/core": "2.8.0",
    "uuid": "11.1.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "firebase": "^11.10.0",
    "firebase-tools": "^15.25.1",
    "typescript": "^5.6.3"
  }
}
